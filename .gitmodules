[submodule "contracts/lib/swap-vm"]
	path = contracts/lib/swap-vm
	url = https://github.com/1inch/swap-vm.git
	ignore = untracked
[submodule "contracts/lib/aqua"]
	path = contracts/lib/aqua
	url = https://github.com/1inch/aqua.git
	ignore = untracked
[submodule "contracts/lib/forge-std"]
	path = contracts/lib/forge-std
	url = https://github.com/foundry-rs/forge-std.git
	ignore = untracked
[submodule "contracts/lib/openzeppelin-contracts"]
	path = contracts/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts.git
	ignore = untracked
[submodule "contracts/lib/solidity-utils"]
	path = contracts/lib/solidity-utils
	url = https://github.com/1inch/solidity-utils.git
	ignore = untracked
