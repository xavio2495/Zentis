{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "bun-types"
    ],
    "noEmit": true,
    "paths": {
      "react-devtools-core": [
        "./src/stubs/react-devtools-core.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "*.test.ts",
    "*.test.tsx"
  ]
}