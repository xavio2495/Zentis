{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "(cd ../../packages/strategy-sdk && bun install) && (cd ../../packages/console-data && bun install) && bun run ../tui/scripts/publish-console.ts && next build",
    "start": "bun run scripts/serve.ts",
